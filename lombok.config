# Lombok configuration for Jackson 3 compatibility (Spring Boot 4.x)
#
# Problem: Jackson 3 bundles ParameterNamesModule by default. It reads the
# MethodParameters bytecode table that Lombok writes on @AllArgsConstructor,
# treats it as a "properties-based creator", and then fails on partial JSON
# (e.g. { projId: 33 }) because it cannot satisfy all 8 constructor args.
#
# Fix: This flag makes Lombok annotate every generated constructor with
# @java.beans.ConstructorProperties, which Jackson 3 recognises as an explicit
# property-based creator declaration. Jackson then maps only the provided JSON
# fields and leaves the rest null/default, exactly as the no-arg + setter path
# did in Jackson 2.
#
# Scope: affects only Lombok-generated constructors in this module.
# No source files are changed; rebuild required after adding this file.
lombok.anyConstructor.addConstructorProperties = true
